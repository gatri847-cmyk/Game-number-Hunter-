    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        * {
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            background-color: #030712;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Edge-to-Edge Ambient Canvases */
        canvas.bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        canvas#confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 60;
        }

        /* Modern Glassmorphism Panels */
        .glass-panel {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 40px rgba(99, 102, 241, 0.15), 0 20px 50px rgba(0, 0, 0, 0.6);
        }

        .glass-button {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-button:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .glass-button:active {
            transform: translateY(0);
        }

        .glass-button.active {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-color: #a78bfa;
            box-shadow: 0 0 25px rgba(124, 58, 237, 0.5);
        }

        @keyframes pulseBorder {
            0%, 100% { border-color: rgba(99, 102, 241, 0.4); box-shadow: 0 0 25px rgba(99, 102, 241, 0.2); }
            50% { border-color: rgba(168, 85, 247, 0.8); box-shadow: 0 0 40px rgba(168, 85, 247, 0.4); }
        }

        .animated-edge-glow {
            animation: pulseBorder 4s infinite ease-in-out;
        }

        @keyframes shakeHard {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px) rotate(-1deg); }
            40%, 80% { transform: translateX(8px) rotate(1deg); }
        }

        .shake-animation {
            animation: shakeHard 0.4s ease-in-out;
        }

        @keyframes floatUpDown {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }

