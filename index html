    <meta name="theme-color" content="#030712">
    <meta property="og:title" content="MTs DDI Kelurahan Baru - Number Hunter">
    <meta property="og:description" content="Game Edukasi Matematika & Logika untuk Siswa MTs DDI Kelurahan Baru.">
    <meta property="og:type" content="website">

    <!-- SVG Favicon (Inline Emoji) -->
