<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTs DDI Kelurahan Baru - Number Hunter</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
            box-sizing: border-box;
        }

        body {
            background-color: #030712;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Edge-to-Edge Ambient Canvases */
        canvas.bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        canvas#confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 60;
        }

        /* Modern Glassmorphic Container */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 40px rgba(99, 102, 241, 0.15), 0 20px 50px rgba(0, 0, 0, 0.6);
        }

        .glass-panel-glow {
            box-shadow: 0 0 35px rgba(129, 140, 248, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
        }

        .glass-button {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-button:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .glass-button:active {
            transform: translateY(0);
        }

        .glass-button.active {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-color: #a78bfa;
            box-shadow: 0 0 25px rgba(124, 58, 237, 0.5);
        }

        @keyframes pulseBorder {
            0%, 100% { border-color: rgba(99, 102, 241, 0.4); box-shadow: 0 0 20px rgba(99, 102, 241, 0.2); }
            50% { border-color: rgba(168, 85, 247, 0.8); box-shadow: 0 0 35px rgba(168, 85, 247, 0.4); }
        }

        .animated-edge-glow {
            animation: pulseBorder 4s infinite ease-in-out;
        }

        @keyframes shakeHard {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px) rotate(-1deg); }
            40%, 80% { transform: translateX(8px) rotate(1deg); }
        }

        .shake-animation {
            animation: shakeHard 0.4s ease-in-out;
        }

        @keyframes floatUpDown {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }

        .float-icon {
            animation: floatUpDown 3s ease-in-out infinite;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(124, 58, 237, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(124, 58, 237, 0.8);
        }
    </style>
</head>
<body class="text-slate-100 flex items-center justify-center p-3 sm:p-6 relative min-h-screen">

<canvas id="bg-canvas" class="bg-canvas"></canvas>
<canvas id="confetti-canvas"></canvas>

<!-- Ambient Glowing Orbs at screen corners for edge animations -->
<div class="fixed top-0 left-0 w-80 h-80 bg-indigo-600/20 rounded-full filter blur-[100px] pointer-events-none"></div>
<div class="fixed bottom-0 right-0 w-96 h-96 bg-purple-600/20 rounded-full filter blur-[120px] pointer-events-none"></div>
<div class="fixed top-1/2 right-0 w-72 h-72 bg-emerald-500/15 rounded-full filter blur-[90px] pointer-events-none"></div>

<div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-5 py-3.5 rounded-2xl glass-panel text-white font-medium shadow-2xl transition-all duration-300 opacity-0 translate-y-[-20px] pointer-events-none border border-amber-500/30">
    <span id="toast-icon" class="text-2xl">⚠️</span>
    <span id="toast-msg">Notifikasi</span>
</div>

<main class="w-full max-w-lg glass-panel animated-edge-glow rounded-3xl p-5 sm:p-8 relative z-10 border my-4">
    
    <!-- App Header -->
    <header class="flex items-center justify-between mb-6 pb-4 border-b border-slate-700/60">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-emerald-400 flex items-center justify-center shadow-lg shadow-indigo-500/30 float-icon text-2xl font-black">
                🏫
            </div>
            <div>
                <span class="text-[11px] font-bold uppercase tracking-widest text-emerald-400 block">Game Edukasi & Logika</span>
                <h1 class="text-xl sm:text-2xl font-black bg-gradient-to-r from-sky-400 via-indigo-300 to-purple-300 bg-clip-text text-transparent leading-tight">
                    MTs DDI Kelurahan Baru
                </h1>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <!-- Audio Mute Button -->
            <button id="sound-btn" onclick="toggleSound()" class="p-2.5 rounded-xl glass-button text-slate-300 hover:text-white" title="Suara">
                <span id="sound-icon" class="text-lg">🔊</span>
            </button>
            <!-- Restart Button -->
            <button onclick="resetToStartScreen()" class="p-2.5 rounded-xl glass-button text-slate-300 hover:text-white" title="Kembali ke Menu Utama">
                🏠
            </button>
        </div>
    </header>

    <!-- START SCREEN (Displayed before game begins) -->
    <section id="start-screen" class="text-center py-4">
        <div class="mb-6">
            <div class="inline-block p-4 rounded-3xl bg-indigo-950/60 border border-indigo-500/30 mb-3 shadow-inner">
                <span class="text-5xl">🎯</span>
            </div>
            <h2 class="text-2xl font-extrabold text-white mb-2">Number Hunter Challenge</h2>
            <p class="text-xs sm:text-sm text-slate-300 max-w-xs mx-auto leading-relaxed">
                Tebak angka rahasia dalam batas percobaan yang ditentukan. Gali kemampuan analisismu!
            </p>
        </div>

        <div class="mb-6 text-left bg-slate-900/60 p-4 rounded-2xl border border-slate-800">
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">1. Pilih Tingkat Kesulitan:</label>
            <div class="grid grid-cols-3 gap-2">
                <button id="btn-easy" class="diff-btn glass-button active p-3 rounded-2xl text-xs sm:text-sm font-bold flex flex-col items-center gap-1" onclick="setDifficulty('easy')">
                    <span class="text-emerald-400">Mudah</span>
                    <span class="text-[10px] text-slate-400 font-normal">1 - 50</span>
                    <span class="text-[10px] text-amber-300 font-semibold">8 Percobaan</span>
                </button>
                <button id="btn-medium" class="diff-btn glass-button p-3 rounded-2xl text-xs sm:text-sm font-bold flex flex-col items-center gap-1" onclick="setDifficulty('medium')">
                    <span class="text-indigo-400">Sedang</span>
                    <span class="text-[10px] text-slate-400 font-normal">1 - 100</span>
                    <span class="text-[10px] text-amber-300 font-semibold">10 Percobaan</span>
                </button>
                <button id="btn-hard" class="diff-btn glass-button p-3 rounded-2xl text-xs sm:text-sm font-bold flex flex-col items-center gap-1" onclick="setDifficulty('hard')">
                    <span class="text-purple-400">Sulit</span>
                    <span class="text-[10px] text-slate-400 font-normal">1 - 500</span>
                    <span class="text-[10px] text-amber-300 font-semibold">12 Percobaan</span>
                </button>
            </div>
        </div>

        <!-- BIG START BUTTON -->
        <button id="start-game-btn" onclick="startGame()" class="w-full py-4 px-8 rounded-2xl bg-gradient-to-r from-emerald-500 via-indigo-600 to-purple-600 hover:from-emerald-400 hover:via-indigo-500 hover:to-purple-500 text-white font-black text-lg tracking-wide shadow-xl shadow-indigo-600/30 transition-all duration-300 hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-3">
            <span>🚀 MULAI PERMAINAN</span>
        </button>
    </section>

    <!-- GAME PLAY PANEL (Hidden until Start is clicked) -->
    <section id="game-panel" class="hidden">
        
        <!-- Stats Dashboard -->
        <div class="grid grid-cols-3 gap-3 mb-5">
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-3 text-center">
                <span class="text-[10px] sm:text-xs text-slate-400 font-semibold block mb-1">Sisa Kesempatan</span>
                <span id="attempts-left" class="text-xl font-extrabold text-amber-400">8</span>
                <div id="hearts-container" class="flex justify-center gap-0.5 mt-1 text-[10px]">❤️❤️❤️❤️❤️❤️❤️❤️</div>
            </div>
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-3 text-center">
                <span class="text-[10px] sm:text-xs text-slate-400 font-semibold block mb-1">Rekor Terbaik</span>
                <span id="high-score" class="text-xl font-extrabold text-indigo-400">-</span>
                <span id="diff-label" class="text-[10px] text-slate-400 block">Mode Mudah</span>
            </div>
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-3 text-center">
                <span class="text-[10px] sm:text-xs text-slate-400 font-semibold block mb-1">Rentetan Menang</span>
                <span id="win-streak" class="text-xl font-extrabold text-emerald-400">0 🔥</span>
                <span class="text-[10px] text-slate-400 block">Berturut-turut</span>
            </div>
        </div>

        <!-- Range Gauge Bar -->
        <div class="mb-5 bg-slate-900/70 border border-slate-800 rounded-2xl p-3.5">
            <div class="flex justify-between items-center text-xs text-slate-300 font-semibold mb-2">
                <span>Rentang Angka Aktif:</span>
                <span id="range-bounds-text" class="text-indigo-300 font-bold font-mono">1 ~ 50</span>
            </div>
            <div class="relative w-full h-3 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
                <div id="range-bar" class="absolute top-0 bottom-0 bg-gradient-to-r from-emerald-400 via-indigo-500 to-purple-500 rounded-full transition-all duration-500" style="left: 0%; right: 0%;"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-mono">
                <span id="min-bound-label">1</span>
                <span id="max-bound-label">50</span>
            </div>
        </div>

        <!-- Input & Action Controls -->
        <div class="mb-5">
            <div class="flex gap-2 mb-3">
                <input type="number" id="guess-input" placeholder="💡 Berapa angkanya?" 
                    class="w-full bg-slate-950/90 border-2 border-slate-700 focus:border-indigo-500 text-white font-extrabold text-2xl text-center py-3 px-4 rounded-2xl outline-none transition-all placeholder:text-slate-600 placeholder:text-sm placeholder:font-normal"
                    onkeydown="if(event.key==='Enter') makeGuess()">
                <button id="submit-btn" onclick="makeGuess()" 
                    class="bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 active:scale-95 text-white font-extrabold px-6 rounded-2xl shadow-lg shadow-indigo-500/25 transition-all text-base min-w-[100px]">
                    Tebak
                </button>
            </div>

            <!-- Quick Adjustment Helper Buttons -->
            <div class="flex justify-center gap-1.5">
                <button onclick="adjustGuess(-10)" class="glass-button text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-300 hover:text-white">-10</button>
                <button onclick="adjustGuess(-1)" class="glass-button text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-300 hover:text-white">-1</button>
                <button onclick="adjustGuess(1)" class="glass-button text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-300 hover:text-white">+1</button>
                <button onclick="adjustGuess(10)" class="glass-button text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-300 hover:text-white">+10</button>
            </div>
        </div>

        <!-- Feedback Message Display -->
        <div id="feedback" class="min-h-[60px] flex items-center justify-center text-center font-bold text-sm sm:text-base rounded-2xl p-3 border transition-all duration-300 mb-5 bg-slate-900/60 border-slate-800 text-slate-300 shadow-inner">
            🔍 Ketik tebakanmu lalu tekan tombol Tebak!
        </div>

        <!-- Guess History Container -->
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Riwayat Analisis</span>
                <span id="history-count" class="text-[11px] font-semibold text-slate-500">0 langkah</span>
            </div>
            <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-2 max-h-36 overflow-y-auto" id="history-scroll">
                <div id="history-container" class="space-y-1.5">
                    <p id="empty-history" class="text-xs text-center text-slate-500 py-3 font-medium">Belum ada tebakan dibuat</p>
                </div>
            </div>
        </div>
    </section>

</main>

<script>
    let currentDifficulty = 'easy';
    let maxRange = 50;
    let maxAttempts = 8;
    let attemptsLeft = 8;
    let minBound = 1;
    let maxBound = 50;
    let targetNumber = 0;
    let totalGuessesMade = 0;
    let gameOver = false;
    let gameStarted = false;
    let winStreak = 0;
    let soundEnabled = true;

    // Web Audio Synthesizer Context
    let audioCtx = null;

    function getAudioContext() {
        if (!audioCtx) {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (AudioContext) audioCtx = new AudioContext();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
            audioCtx.resume();
        }
        return audioCtx;
    }

    function playTone(freq, duration, type = 'sine') {
        if (!soundEnabled) return;
        try {
            const ctx = getAudioContext();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {
            console.error(e);
        }
    }

    function playSound(effect) {
        if (!soundEnabled) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        if (effect === 'start') {
            [300, 450, 600].forEach((freq, idx) => {
                setTimeout(() => playTone(freq, 0.15, 'triangle'), idx * 80);
            });
        } else if (effect === 'win') {
            [261.63, 329.63, 392.00, 523.25, 659.25].forEach((freq, idx) => {
                setTimeout(() => playTone(freq, 0.25, 'triangle'), idx * 90);
            });
        } else if (effect === 'lose') {
            [300, 250, 200, 150].forEach((freq, idx) => {
                setTimeout(() => playTone(freq, 0.2, 'sawtooth'), idx * 100);
            });
        } else if (effect === 'high') {
            playTone(350, 0.12, 'sawtooth');
        } else if (effect === 'low') {
            playTone(220, 0.12, 'square');
        } else if (effect === 'error') {
            playTone(140, 0.2, 'sawtooth');
        } else if (effect === 'click') {
            playTone(550, 0.04, 'sine');
        }
    }

    function toggleSound() {
        soundEnabled = !soundEnabled;
        document.getElementById('sound-icon').innerText = soundEnabled ? '🔊' : '🔇';
        showToast(soundEnabled ? 'Suara Diaktifkan' : 'Suara Dimatikan', soundEnabled ? '🔊' : '🔇');
    }

    function showToast(message, icon = '⚠️') {
        const toast = document.getElementById('toast');
        document.getElementById('toast-msg').innerText = message;
        document.getElementById('toast-icon').innerText = icon;

        toast.classList.remove('opacity-0', 'translate-y-[-20px]', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');

        setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-[-20px]', 'pointer-events-none');
        }, 2800);
    }

    function setDifficulty(level) {
        playSound('click');
        currentDifficulty = level;

        document.querySelectorAll('.diff-btn').forEach(btn => btn.classList.remove('active'));

        if (level === 'easy') {
            maxRange = 50;
            maxAttempts = 8;
            document.getElementById('btn-easy').classList.add('active');
            document.getElementById('diff-label').innerText = 'Mode Mudah';
        } else if (level === 'medium') {
            maxRange = 100;
            maxAttempts = 10;
            document.getElementById('btn-medium').classList.add('active');
            document.getElementById('diff-label').innerText = 'Mode Sedang';
        } else if (level === 'hard') {
            maxRange = 500;
            maxAttempts = 12;
            document.getElementById('btn-hard').classList.add('active');
            document.getElementById('diff-label').innerText = 'Mode Sulit';
        }
        updateHighScoreDisplay();
    }

    function resetToStartScreen() {
        playSound('click');
        gameStarted = false;
        gameOver = false;
        document.getElementById('start-screen').classList.remove('hidden');
        document.getElementById('game-panel').classList.add('hidden');
    }

    function startGame() {
        playSound('start');
        gameStarted = true;
        gameOver = false;
        targetNumber = Math.floor(Math.random() * maxRange) + 1;
        attemptsLeft = maxAttempts;
        totalGuessesMade = 0;
        minBound = 1;
        maxBound = maxRange;

        document.getElementById('start-screen').classList.add('hidden');
        document.getElementById('game-panel').classList.remove('hidden');

        document.getElementById('attempts-left').innerText = attemptsLeft;
        updateHeartsDisplay();
        updateHighScoreDisplay();

        const feedbackEl = document.getElementById('feedback');
        feedbackEl.className = 'min-h-[60px] flex items-center justify-center text-center font-bold text-sm sm:text-base rounded-2xl p-3 border transition-all duration-300 mb-5 bg-slate-900/60 border-slate-800 text-slate-300 shadow-inner';
        feedbackEl.innerText = `🎯 Tebak angka antara ${minBound} sampai ${maxBound}!`;
