<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Number Hunter - Cyber Edition</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet">
    
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0b0f19;
            color: #f3f4f6;
            overflow: hidden;
        }
        .font-cyber {
            font-family: 'Orbitron', sans-serif;
        }
        .glow-cyan {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
        }
        .glow-pink {
            box-shadow: 0 0 20px rgba(236, 72, 153, 0.4);
        }
        .text-glow {
            text-shadow: 0 0 10px rgba(59, 130, 246, 0.6);
        }
        .text-glow-gold {
            text-shadow: 0 0 12px rgba(234, 179, 8, 0.8);
        }
        /* Glassmorphism containers */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        /* Custom modal backdrop */
        .modal-bg {
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(8px);
        }
        canvas {
            display: block;
            touch-action: none;
        }
        /* Floating HUD elements animation */
        @keyframes pulseGlow {
            0%, 100% { transform: scale(1); opacity: 0.9; }
            50% { transform: scale(1.05); opacity: 1; }
        }
        .animate-target-pulse {
            animation: pulseGlow 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="relative w-screen h-screen overflow-hidden select-none bg-slate-950 text-white">

    <canvas id="gameCanvas" class="absolute inset-0 z-0 w-full h-full"></canvas>

    <div id="hud" class="relative z-10 p-3 sm:p-5 flex flex-col justify-between h-full pointer-events-none">
        
        <!-- Top Bar Header -->
        <div class="flex items-center justify-between w-full max-w-5xl mx-auto gap-2 sm:gap-4 pointer-events-auto">
            
            <!-- Left Info: Score & Highscore -->
            <div class="glass-panel px-3 py-2 sm:px-5 sm:py-3 rounded-2xl flex items-center gap-3 border border-slate-700/60 shadow-lg">
                <div class="p-2 bg-indigo-500/20 text-indigo-400 rounded-xl">
                    <i class="fa-solid fa-trophy text-lg sm:text-xl"></i>
                </div>
                <div>
                    <div class="text-[10px] sm:text-xs text-slate-400 font-semibold uppercase tracking-wider">Skor Kamu</div>
                    <div id="scoreDisplay" class="text-xl sm:text-3xl font-cyber font-bold text-cyan-400">0</div>
                </div>
            </div>

            <!-- Target Banner (Center Highlight) -->
            <div class="flex-1 max-w-xs sm:max-w-md mx-1">
                <div id="targetBox" class="glass-panel px-3 py-2 sm:px-6 sm:py-3 rounded-2xl text-center border border-cyan-500/40 glow-cyan animate-target-pulse transition-all duration-300">
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-cyan-300 font-bold block">TARGET BERBURU</span>
                    <h2 id="targetText" class="text-sm sm:text-2xl font-black font-cyber text-amber-300 text-glow-gold truncate">
                        Memuat Target...
                    </h2>
                </div>
            </div>

            <!-- Right Info: Health & Combo -->
            <div class="glass-panel px-3 py-2 sm:px-5 sm:py-3 rounded-2xl flex items-center gap-3 border border-slate-700/60 shadow-lg">
                <div class="text-right">
                    <div class="text-[10px] sm:text-xs text-slate-400 font-semibold uppercase tracking-wider">Nyawa & Combo</div>
                    <div class="flex items-center justify-end gap-1 mt-0.5" id="healthDisplay">
                        <!-- Hearts dynamically rendered -->
                    </div>
                </div>
                <div id="comboDisplay" class="p-2 bg-pink-500/20 text-pink-400 rounded-xl font-cyber font-bold text-xs sm:text-sm">
                    x1
                </div>
            </div>

        </div>

        <div class="flex items-end justify-between w-full max-w-5xl mx-auto pb-2 sm:pb-4 pointer-events-auto">
            
            <!-- Powerups Panel -->
            <div class="flex gap-2 sm:gap-3">
                <!-- Freeze Time Powerup -->
                <button id="btnFreeze" onclick="usePowerup('freeze')" class="glass-panel p-2.5 sm:p-3.5 rounded-2xl flex flex-col items-center justify-center hover:bg-slate-800/80 active:scale-95 transition border border-cyan-500/30 disabled:opacity-40 disabled:pointer-events-none group relative">
                    <i class="fa-solid fa-snowflake text-cyan-400 text-lg sm:text-xl group-hover:scale-110 transition"></i>
                    <span class="text-[9px] sm:text-[10px] mt-1 text-slate-300 font-bold">BEKU (<span id="countFreeze">2</span>)</span>
                </button>

                <!-- Bomb Powerup -->
                <button id="btnBomb" onclick="usePowerup('bomb')" class="glass-panel p-2.5 sm:p-3.5 rounded-2xl flex flex-col items-center justify-center hover:bg-slate-800/80 active:scale-95 transition border border-amber-500/30 disabled:opacity-40 disabled:pointer-events-none group relative">
                    <i class="fa-solid fa-bomb text-amber-400 text-lg sm:text-xl group-hover:scale-110 transition"></i>
                    <span class="text-[9px] sm:text-[10px] mt-1 text-slate-300 font-bold">BOM (<span id="countBomb">1</span>)</span>
                </button>

                <!-- Magnet Powerup -->
                <button id="btnMagnet" onclick="usePowerup('magnet')" class="glass-panel p-2.5 sm:p-3.5 rounded-2xl flex flex-col items-center justify-center hover:bg-slate-800/80 active:scale-95 transition border border-purple-500/30 disabled:opacity-40 disabled:pointer-events-none group relative">
                    <i class="fa-solid fa-magnet text-purple-400 text-lg sm:text-xl group-hover:scale-110 transition"></i>
                    <span class="text-[9px] sm:text-[10px] mt-1 text-slate-300 font-bold">MAGNET (<span id="countMagnet">1</span>)</span>
                </button>
            </div>

            <!-- Sound & Pause Options -->
            <div class="flex gap-2">
                <button onclick="toggleAudio()" id="btnAudio" class="glass-panel p-3 rounded-2xl hover:bg-slate-800 transition text-slate-300">
                    <i class="fa-solid fa-volume-high text-lg"></i>
                </button>
                <button onclick="pauseGame()" class="glass-panel p-3 rounded-2xl hover:bg-slate-800 transition text-slate-300">
                    <i class="fa-solid fa-pause text-lg"></i>
                </button>
            </div>

        </div>

    </div>

    <!-- Start Screen Overlay -->
    <div id="startModal" class="fixed inset-0 z-50 flex items-center justify-center modal-bg p-4">
        <div class="glass-panel max-w-lg w-full rounded-3xl p-6 sm:p-8 text-center border border-slate-700/80 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-cyan-500/20 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-pink-500/20 rounded-full blur-3xl"></div>
            
            <div class="inline-flex p-4 bg-cyan-500/10 rounded-3xl border border-cyan-500/30 mb-4 text-cyan-400">
                <i class="fa-solid fa-crosshair text-4xl sm:text-5xl"></i>
            </div>

            <h1 class="text-3xl sm:text-5xl font-black font-cyber tracking-tight text-white mb-2">
                NUMBER <span class="text-cyan-400">HUNTER</span>
            </h1>
            <p class="text-slate-400 text-sm sm:text-base mb-6">
                Uji kecepatan refleks dan logika matematika! Temukan dan hancurkan angka yang sesuai target sebelum waktu habis.
            </p>

            <!-- Mode Selector -->
            <div class="space-y-3 mb-6 text-left">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Pilih Mode Game:</label>
                
                <button onclick="selectMode('rule')" id="modeRuleBtn" class="w-full p-3.5 rounded-2xl border border-cyan-500 bg-cyan-500/20 text-white flex items-center justify-between transition hover:border-cyan-400">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-filter text-cyan-400 text-xl"></i>
                        <div class="text-left">
                            <div class="font-bold text-sm">Mode Target Aturan</div>
                            <div class="text-xs text-slate-300">Cari Prima, Kelipatan, Genap/Ganjil, dll.</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-circle-check text-cyan-400"></i>
                </button>

                <button onclick="selectMode('sequence')" id="modeSeqBtn" class="w-full p-3.5 rounded-2xl border border-slate-700 bg-slate-900/50 text-slate-300 flex items-center justify-between transition hover:border-slate-500">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-arrow-down-1-9 text-pink-400 text-xl"></i>
                        <div class="text-left">
                            <div class="font-bold text-sm">Mode Urutan Angka</div>
                            <div class="text-xs text-slate-400">Berburu angka berurutan 1, 2, 3... tercepat!</div>
                        </div>
                    </div>
                    <i class="fa-regular fa-circle text-slate-600"></i>
                </button>
            </div>

            <button onclick="startGame()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 font-cyber font-bold text-lg text-white shadow-lg glow-cyan hover:brightness-110 active:scale-95 transition">
                MULAI BERBURU <i class="fa-solid fa-play ml-2"></i>
            </button>
        </div>
    </div>

    <!-- Pause Modal -->
    <div id="pauseModal" class="hidden fixed inset-0 z-50 flex items-center justify-center modal-bg p-4">
        <div class="glass-panel max-w-sm w-full rounded-3xl p-6 text-center border border-slate-700">
            <h3 class="text-2xl font-cyber font-bold mb-4">GAME DIPAUS</h3>
            <div class="space-y-3">
                <button onclick="resumeGame()" class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 font-bold text-slate-950">
                    Lanjutkan <i class="fa-solid fa-play ml-1"></i>
                </button>
                <button onclick="restartGame()" class="w-full py-3 rounded-xl bg-slate-800 hover:bg-slate-700 font-bold text-white border border-slate-600">
                    Ulangi Game <i class="fa-solid fa-rotate-right ml-1"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Game Over Modal -->
    <div id="gameOverModal" class="hidden fixed inset-0 z-50 flex items-center justify-center modal-bg p-4">
        <div class="glass-panel max-w-md w-full rounded-3xl p-6 sm:p-8 text-center border border-slate-700 relative">
            <div class="w-20 h-20 bg-rose-500/20 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-rose-500/40">
                <i class="fa-solid fa-skull-crossbones text-3xl"></i>
            </div>
            
            <h2 class="text-3xl font-cyber font-black text-white mb-1">GAME OVER</h2>
            <p class="text-slate-400 text-sm mb-6">Waktu atau nyawa kamu telah habis!</p>

            <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="bg-slate-900/80 p-3 rounded-2xl border border-slate-800">
                    <span class="text-xs text-slate-400 block font-bold">SKOR AKHIR</span>
                    <span id="finalScore" class="text-2xl font-cyber font-bold text-cyan-400">0</span>
                </div>
                <div class="bg-slate-900/80 p-3 rounded-2xl border border-slate-800">
                    <span class="text-xs text-slate-400 block font-bold">REKOR TERBAIK</span>
                    <span id="highScore" class="text-2xl font-cyber font-bold text-amber-400">0</span>
                </div>
            </div>

            <button onclick="restartGame()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 font-cyber font-bold text-lg text-white shadow-lg glow-cyan hover:brightness-110 active:scale-95 transition">
                MAIN LAGI <i class="fa-solid fa-rotate-right ml-2"></i>
            </button>
        </div>
    </div>

    <script>
        // Audio Synthesizer (No external asset files required!)
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
            }

            playPop() {
                if (this.muted || !this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(300, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(800, this.ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.08);
            }

            playWrong() {
                if (this.muted || !this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, this.ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(80, this.ctx.currentTime + 0.2);
                gain.gain.setValueAtTime(0.4, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.2);
            }

            playPowerup() {
                if (this.muted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(200, now);
                osc.frequency.exponentialRampToValueAtTime(1200, now + 0.3);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(now + 0.3);
            }

            playGameOver() {
                if (this.muted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.exponentialRampToValueAtTime(60, now + 0.6);
                gain.gain.setValueAtTime(0.4, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.6);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(now + 0.6);
            }
        }

        const audio = new SoundFX();

        function toggleAudio() {
            audio.init();
            audio.muted = !audio.muted;
            const btn = document.getElementById('btnAudio');
            btn.innerHTML = audio.muted ? 
                '<i class="fa-solid fa-volume-xmark text-lg text-rose-400"></i>' : 
                '<i class="fa-solid fa-volume-high text-lg text-cyan-400"></i>';
        }

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let gameState = {
            active: false,
            paused: false,
            mode: 'rule', // 'rule' or 'sequence'
            score: 0,
            combo: 1,
            health: 3,
            maxHealth: 5,
            sequenceNext: 1,
            targetRule: null,
            targets: [],
            particles: [],
            floatingTexts: [],
            spawnTimer: 0,
            spawnInterval: 60, // frames
            powerups: { freeze: 2, bomb: 1, magnet: 1 },
            freezeTimer: 0
        };

        // Resize Canvas dynamically
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        const RULES = [
            { id: 'prime', label: 'Bilangan Prima', check: isPrime },
            { id: 'even', label: 'Bilangan Genap', check: n => n % 2 === 0 },
            { id: 'odd', label: 'Bilangan Ganjil', check: n => n % 2 !== 0 },
            { id: 'mult3', label: 'Kelipatan 3', check: n => n % 3 === 0 },
            { id: 'mult5', label: 'Kelipatan 5', check: n => n % 5 === 0 },
            { id: 'mult7', label: 'Kelipatan 7', check: n => n % 7 === 0 },
            { id: 'gt50', label: 'Angka > 50', check: n => n > 50 },
            { id: 'lt30', label: 'Angka < 30', check: n => n < 30 },
            { id: 'square', label: 'Kuadrat Sempurna', check: isSquare }
        ];

        function isPrime(num) {
            if (num <= 1) return false;
            if (num <= 3) return true;
            if (num % 2 === 0 || num % 3 === 0) return false;
            for (let i = 5; i * i <= num; i += 6) {
                if (num % i === 0 || num % (i + 2) === 0) return false;
            }
            return true;
        }

        function isSquare(num) {
            return Math.sqrt(num) % 1 === 0;
        }

        function selectMode(m) {
            gameState.mode = m;
            const rBtn = document.getElementById('modeRuleBtn');
            const sBtn = document.getElementById('modeSeqBtn');
            if (m === 'rule') {
                rBtn.className = "w-full p-3.5 rounded-2xl border border-cyan-500 bg-cyan-500/20 text-white flex items-center justify-between transition hover:border-cyan-400";
                rBtn.querySelector('.fa-circle-check, .fa-circle').className = "fa-solid fa-circle-check text-cyan-400";
                sBtn.className = "w-full p-3.5 rounded-2xl border border-slate-700 bg-slate-900/50 text-slate-300 flex items-center justify-between transition hover:border-slate-500";
                sBtn.querySelector('.fa-circle-check, .fa-circle').className = "fa-regular fa-circle text-sl
